# Live Binance (read-only portfolio / optional live later)
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here

# Optional aliases
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# Optional: Binance Demo Trading (demo.binance.com) — separate keys from live
# Create keys at: https://demo.binance.com/en/my/settings/api-management
# Then in code use: exchange.enable_demo_trading(True)
# DEMO_EXCHANGE_API_KEY=
# DEMO_EXCHANGE_API_SECRET=

# IBKR Flex Web Service (Account Management → Reports → Flex Queries)
# 1) Create Flex Query with section "Open Positions" (STK/ETF) + Cash Report
# 2) Enable Flex Web Service → generate Token + note Query ID
# IBKR_ACCOUNT_ID=Uxxxxxxx
# IBKR_FLEX_TOKEN=
# IBKR_FLEX_QUERY_ID=

# Optional LLM (rebalance news classifier)
# OPENAI_API_KEY=
